[Unit]
Description=Load wlan module
Conflicts=shutdown.target actdead.target

[Service]
# Type=oneshot, not simple: `modprobe wlan` takes ~12 s (WCNSS firmware download
# happens in module init), and Type=simple reported the unit started 12 s before
# the module existed, which broke the ordering bluebinder.service.d relies on.
#
# macaddrsetup.sh must run before the modprobe -- prima reads the platform MAC
# once, at module init. See the script.
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/touch /dev/wcnss_wlan
ExecStartPre=/bin/sh /usr/bin/droid/macaddrsetup.sh
ExecStart=/sbin/modprobe wlan
ExecStop=/sbin/modprobe -r wlan

[Install]
WantedBy=multi-user.target

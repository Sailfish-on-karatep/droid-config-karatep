# arm_droid_default.pa loads module-droid-card from this file when it exists.
# rate=48000 comes from the line it replaces; the codec backend is 48 kHz only.
#
# config=  the vendor policy XML leaves the built-in mics out of the "primary
#          input" route, so the HAL rejects every capture. Our copy differs
#          only there.
# use_legacy_stream_set_parameters=  this HAL returns -ENOSYS from
#          create_audio_patch, so patch-based rerouting fails and a stream
#          stays on the device it was opened with (i.e. the speaker).
load-module module-droid-card rate=48000 config=/etc/pulse/droid/audio_policy_configuration.xml use_legacy_stream_set_parameters=true
